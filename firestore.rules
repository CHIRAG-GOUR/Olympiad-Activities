rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'pa1@skillizee.io' ||
        request.auth.token.role == 'SUPER_ADMIN' ||
        getUserData().role == 'SUPER_ADMIN'
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.role == 'TEACHER' ||
        getUserData().role == 'TEACHER'
      );
    }

    function isStudent() {
      return isAuthenticated() && (
        request.auth.token.role == 'STUDENT' ||
        getUserData().role == 'STUDENT'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isOwner(userId);
    }

    // 2. Exams collection
    match /exams/{examId} {
      allow read: if true; // Publicly readable for students/candidates
      allow write: if isTeacher() || isSuperAdmin();
    }

    // 3. Questions collection
    match /questions/{questionId} {
      allow read: if true; // Loaded for exam sessions
      allow write: if isTeacher() || isSuperAdmin();
    }

    // 4. Subjects collection
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isTeacher() || isSuperAdmin();
    }

    // 5. Exam Sessions / Live Monitor collection
    match /examSessions/{sessionId} {
      allow read: if isTeacher() || isSuperAdmin() || resource.data.studentId == request.auth.uid;
      allow create, update: if true; // Allows candidates to stream heartbeats and telemetry
      allow delete: if isSuperAdmin();
    }

    // 6. Exam Attempts collection
    match /attempts/{attemptId} {
      allow read: if isTeacher() || isSuperAdmin() || resource.data.student.studentId == request.auth.uid;
      allow create: if isAuthenticated() || request.resource.data.student.studentId != null;
      allow update, delete: if isSuperAdmin();
    }

    // 7. Exam Reports collection
    match /reports/{reportId} {
      allow read: if isTeacher() || isSuperAdmin() || resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated() || request.resource.data.studentId != null;
      allow update, delete: if isSuperAdmin();
    }
  }
}
