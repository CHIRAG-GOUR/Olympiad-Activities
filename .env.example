# ==============================================================================
# OLYMPIAD DIGITAL EXAMINATION PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# This template supports ONE CODEBASE across:
# 1. Local Development (localhost:3000)
# 2. Vercel Hosting (Preview / Production)
# 3. Firebase Infrastructure / Hosting (Future Production)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Environment
# ------------------------------------------------------------------------------
# Environment mode: 'development' | 'preview' | 'production'
NEXT_PUBLIC_APP_ENV=development

# Canonical application URL (no trailing slash)
# Local: http://localhost:3000
# Vercel Preview: https://olympiad-preview.vercel.app
# Vercel Production: https://olympiad.skillizee.io
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Data Provider Selection
# ------------------------------------------------------------------------------
# Supported providers:
# - 'local'    : Uses IndexedDB + LocalStorage (Zero external dependency; Vercel ready)
# - 'firebase' : Uses Cloud Firestore & Firebase Auth (When Firebase is configured)
NEXT_PUBLIC_DATA_PROVIDER=local

# ------------------------------------------------------------------------------
# 3. Firebase Client SDK (Public Web Configuration)
# ------------------------------------------------------------------------------
# Leave empty or with placeholders when deploying on Vercel without Firebase.
# Populate with your Firebase Console Project settings when activating Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=olympiad-dashboard.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=olympiad-dashboard
NEXT_PUBLIC_FIREBASE_DATABASE_ID=olympiad
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=olympiad-dashboard.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 4. Server-Side Privileged Credentials (NEVER USE NEXT_PUBLIC_ PREFIX)
# ------------------------------------------------------------------------------
# Used ONLY in Server Actions / Cloud Functions / Admin API routes.
# NEVER exposed to the client bundle.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
